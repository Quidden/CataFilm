APP_NAME=CataFilm
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=catafilm
DB_USERNAME=laravel
DB_PASSWORD=secret

PGADMIN_PASSWORD=pgapasswd
PGADMIN_EMAIl=example@gmail.com
PGADMIN_PORT=5050

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120
L5_SWAGGER_GENERATE_ALWAYS=true
